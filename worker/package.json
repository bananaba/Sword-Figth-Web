{
  "name": "@vibejam/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn workspace @vibejam/shared build && yarn build && node --test test/*.test.js",
    "clean": "rimraf dist",
    "dev": "yarn build && wrangler dev",
    "deploy": "yarn build && wrangler deploy",
    "tail": "wrangler tail",
    "wrangler": "wrangler"
  },
  "dependencies": {
    "@vibejam/shared": "0.1.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
